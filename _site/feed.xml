    <title>2.Redis哨兵机制</title>
    <link href="http://localhost:4000/redis/redis%E6%A8%A1%E5%BC%8F/%E5%93%A8%E5%85%B5%E6%9C%BA%E5%88%B6/" rel="alternate" type="text/html" title="2.Redis哨兵机制" />
