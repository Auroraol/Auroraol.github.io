                "type": "long"
            }
        }
    },
    "settings": {
        "index": {
            "refresh_interval": "1s",
            "indexing": {
                "slowlog": {
                    "level": "info",
                    "threshold": {
                        "index": {
                            "trace": "1s",
                            "debug": "2s",
                            "info": "3s",
                            "warn": "5s"
                        }
                    },
                    "source": "1000"
                }
            },
            "translog": {
                "sync_interval": "5s",
                "durability": "async"
            },
            "max_result_window": "250000",
            "unassigned": {
                "node_left": {
                    "delayed_timeout": "5m"
                }
            },
            "number_of_replicas": "1",
            "codec": "best_compression",
            "search": {
                "slowlog": {
                    "level": "info",
                    "threshold": {
                        "fetch": {
                            "trace": "200ms",
                            "debug": "500ms",
                            "info": "800ms",
                            "warn": "1s"
                        },
                        "query": {
                            "trace": "500ms",
                            "debug": "1s",
                            "info": "3s",
                            "warn": "5s"
                        }
                    }
                }
            },
            "number_of_shards": "3",
            "max_ngram_diff": 2
        },
        "analysis": {
            "analyzer": {
                "trigram_analyzer": {
                    "type": "custom",
                    "tokenizer": "trigram_tokenizer",
                    "filter": [
                        "lowercase"
                    ]
                },
                "ngram_one_analyzer": {
                    "type": "custom",
                    "tokenizer": "ngram_one_tokenizer",
                    "filter": [
                        "lowercase"
                    ]
                }
            },
            "tokenizer": {
                "trigram_tokenizer": {
                    "type": "ngram",
                    "min_gram": 1,
                    "max_gram": 3,
                    "token_chars": [
                        "letter",
                        "digit",
                        "punctuation",
                        "symbol"
                    ]
                },
                "ngram_one_tokenizer": {
                    "type": "ngram",
                    "min_gram": 1,
                    "max_gram": 1,
                    "token_chars": [
                        "letter",
                        "digit",
                        "punctuation",
                        "symbol"
                    ]
                }
            }
        }
    }
}